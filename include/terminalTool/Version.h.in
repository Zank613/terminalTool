#pragma once

namespace tt {

/** @brief terminalTool semantic version information. */
namespace Version {
    inline constexpr int Major = @PROJECT_VERSION_MAJOR@; ///< Major version component.
    inline constexpr int Minor = @PROJECT_VERSION_MINOR@; ///< Minor version component.
    inline constexpr int Patch = @PROJECT_VERSION_PATCH@; ///< Patch version component.
    inline constexpr const char* String = "@PROJECT_VERSION@"; ///< Complete semantic version.
}

} // namespace tt
