#pragma once

#define TERMINALTOOL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TERMINALTOOL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TERMINALTOOL_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define TERMINALTOOL_VERSION_STRING "@PROJECT_VERSION@"

namespace tt {

/** @brief terminalTool semantic version information generated by CMake. */
namespace Version {
    inline constexpr int Major = TERMINALTOOL_VERSION_MAJOR; ///< Major version component.
    inline constexpr int Minor = TERMINALTOOL_VERSION_MINOR; ///< Minor version component.
    inline constexpr int Patch = TERMINALTOOL_VERSION_PATCH; ///< Patch version component.
    inline constexpr const char* String = TERMINALTOOL_VERSION_STRING; ///< Complete semantic version.
}

} // namespace tt
